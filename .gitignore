# ---- Area de recuperacao do finetuning — NUNCA versionar ----
# Contem o dataset anotado com nome de operador do ONS e de agente, e os audios
# de comunicacao operativa. E area de trabalho local, nao artefato do projeto.
restore_finetuning/

# ---- Dados operacionais — nunca versionar ----
# Gravações, transcrições e qualquer saída derivada de áudio real.
*.wav
*.mp3
*.m4a
*.ogg
*.flac
audios/
transcriptions/
transcricoes/
tmp/
outputs/*.csv
outputs/*.jsonl
outputs/*.txt
!outputs/README.md

# ---- Artefatos de build de lambda ----
# Estes .zip sao GERADOS por data "archive_file" no terraform apply a partir do
# diretorio de codigo ao lado. Versiona-los duplica o codigo e faz o artefato ficar
# defasado em relacao a fonte.
ONSTranscribe/api/terraform/lambdas/*.zip
# Os layers sao dependencias empacotadas, nao gerados a partir do repositorio:
!ONSTranscribe/api/terraform/lambdas/layers/*.zip

# ---- Prompts de dominio ----
# Regra herdada do ONSTranscribe/.gitignore, que saiu do repositorio: os .txt reais sao
# especificos de cada ambiente e nao entram aqui; so os .example.txt sao versionados.
# prompts.tf resolve o arquivo com fileexists(), caindo no .example.txt quando falta o .txt.
ONSTranscribe/api/terraform/prompts/*.txt
!ONSTranscribe/api/terraform/prompts/*.example.txt

# ---- Workspace gerado pela esteira de montagem ----
.generated/

# ---- Configuracao de devcontainer ----
.devcontainer

# ---- Modelos ----
# Pesos ficam no S3, não no repositório.
models/
models_teste/
*.ckpt
*.safetensors
*.bin

# ---- Area de trabalho para publicacao no Hugging Face ----
# Copia local dos pesos baixados do S3, para preparar e subir os repositorios no HF.
