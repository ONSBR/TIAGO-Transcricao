# =============================================================================
# cleanup.env.sample
#
# Configuração do script cleanup_and_redeploy.sh
#
# Uso:
#   cp cleanup.env.sample cleanup.env
#   # edite cleanup.env com os valores do seu ambiente
#
# IMPORTANTE: cleanup.env está no .gitignore — nunca sobe ao repositório.
#             Este arquivo .sample é o único que vai ao git.
# =============================================================================

# Nome do cluster ECS
CLUSTER=

# Nome do serviço ECS que será redeployado após a limpeza
SERVICE=

# Subnets privadas onde o container instance pode estar.
# Liste todas as subnets privadas do cluster separadas por vírgula.
# O script tenta cada uma até encontrar a correta (erro LOCATION indica subnet errada).
#
# Como descobrir:
#   aws ecs describe-container-instances \
#     --cluster <CLUSTER> \
#     --container-instances $(aws ecs list-container-instances \
#       --cluster <CLUSTER> --query 'containerInstanceArns[0]' --output text \
#       --profile <PROFILE> --region <REGION>) \
#     --query 'containerInstances[0].attributes[?name==`ecs.subnet-id`].value' \
#     --profile <PROFILE> --region <REGION> --output text
SUBNETS_CSV=

# Security group associado ao serviço ECS
SECURITY_GROUP=

# ARN da IAM role de execução das tasks ECS
# (precisa de permissão para pull de imagem ECR e escrita no CloudWatch Logs)
EXECUTION_ROLE_ARN=

# CloudWatch Log Group onde os logs da task de cleanup serão gravados
# (normalmente o mesmo log group do serviço ECS)
LOG_GROUP=

# Profile AWS CLI configurado na sua máquina
AWS_PROFILE=

# Região AWS onde o cluster está
AWS_REGION=
