AWS_PROFILE=seu-profile-aws
AWS_DEFAULT_REGION=us-east-1

RUN_PREFLIGHT_AWS_IDENTITY_CHECK=true
RUN_PREFLIGHT_BEDROCK_CHECK=false
RUN_BOOTSTRAP_PRIVATE_NAT=false
RUN_BOOTSTRAP_OPENSEARCH_DOMAIN=false
RUN_BOOTSTRAP_VPC_ENDPOINTS=false
RUN_CREATE_TERRAFORM_BACKEND=true
RUN_CREATE_ECR=true
RUN_BUILD_PUSH_IMAGE=true
RUN_UPLOAD_MODELS=true
RUN_CREATE_OPENSEARCH_INDEX=false
RUN_PREPARE_TERRAFORM_WORKSPACE=true
RUN_TERRAFORM_VALIDATE=true
RUN_TERRAFORM_PLAN=true
RUN_TERRAFORM_APPLY=true
TF_AUTO_APPROVE=false
RUN_POST_DEPLOY_VALIDATIONS=true
RUN_POST_DEPLOY_HEALTH_ENDPOINT_VALIDATION=true
RUN_POST_DEPLOY_OPENSEARCH_VALIDATION=true

ONST_ROOT=/caminho/para/ONSTranscribe
ONST_API_DIR=/caminho/para/ONSTranscribe/api
ONST_TERRAFORM_SOURCE_DIR=/caminho/para/ONSTranscribe/api/terraform
ONST_TERRAFORM_WORKDIR=/caminho/para/ONSTranscribe/scripts/Montagem_Ambiente/.generated/terraform
TFVARS_FILE=/caminho/para/ONSTranscribe/api/terraform/terraform.tfvars

TF_STATE_BUCKET=nome-do-bucket-do-state
TF_LOCK_TABLE=nome-da-tabela-de-lock
TF_STATE_KEY=terraform/transcribe/transcribe.tfstate
# Pode ser nome simples, caminho relativo ao workdir ou caminho absoluto.
TF_PLAN_FILE=generated.plan

NAT_VPC_ID=vpc-xxxxxxxxxxxxxxxxx
NAT_PUBLIC_SUBNET_ID=subnet-publica-1
NAT_PRIVATE_ROUTE_TABLE_IDS=rtb-private-1
NAT_GATEWAY_NAME={project_name}-nat-dev
NAT_EIP_NAME={project_name}-nat-eip-dev

OPENSEARCH_BOOTSTRAP_VPC_ID=vpc-xxxxxxxxxxxxxxxxx
OPENSEARCH_BOOTSTRAP_SUBNET_IDS=subnet-priv-1
OPENSEARCH_SECURITY_GROUP_NAME={project_name}-opensearch-sg-dev
OPENSEARCH_ENGINE_VERSION=OpenSearch_2.17
OPENSEARCH_INSTANCE_TYPE=t3.small.search
OPENSEARCH_INSTANCE_COUNT=1
OPENSEARCH_VOLUME_TYPE=gp3
OPENSEARCH_VOLUME_SIZE=20
OPENSEARCH_TLS_SECURITY_POLICY=Policy-Min-TLS-1-2-2019-07
# Opcional. Se vazio, o bootstrap libera a VPC inteira no security group do domínio.
OPENSEARCH_ALLOWED_CIDRS=

VPC_ENDPOINTS_VPC_ID=vpc-xxxxxxxxxxxxxxxxx
VPC_ENDPOINTS_PRIVATE_SUBNET_IDS=subnet-priv-1,subnet-priv-2
# Route tables privadas que receberão os endpoints gateway de S3 e DynamoDB.
VPC_ENDPOINTS_ROUTE_TABLE_IDS=rtb-private-1
VPC_ENDPOINTS_SECURITY_GROUP_NAME={project_name}-vpce-sg-dev
VPC_ENDPOINTS_ENABLE_SSM=true
VPC_ENDPOINTS_ENABLE_BEDROCK=true

ECR_REPOSITORY_NAME={project_name}-api
DOCKER_IMAGE_LOCAL_NAME={project_name}-api
DOCKER_IMAGE_TAG=latest

TRANSCRIBE_BUCKET_NAME=nome-do-bucket-principal
WHISPER_MODEL_LOCAL_DIR=/caminho/local/para/whisper-finetuned
WHISPER_MODEL_S3_PREFIX=models-v2/whisper-finetuned/
SEGMENTATION_MODEL_LOCAL_DIR=/caminho/local/para/segmentation-finetuned
SEGMENTATION_MODEL_S3_PREFIX=models-v2/segmentation-finetuned/
SUBJECT_MODEL_LOCAL_DIR=/caminho/local/para/subject-classification-model
SUBJECT_MODEL_S3_PREFIX=models-v2/subject-classification-model/

OPENSEARCH_DOMAIN_NAME=nome-do-dominio-opensearch
OPENSEARCH_INDEX_NAME=nome-do-indice-opensearch
# Formato: <provedor>.<modelo>-<versão>. Ex.: anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_MODEL_ID=seu-modelo-bedrock

ECS_SERVICE_DESIRED_COUNT=1
ECS_AUTOSCALING_MIN_CAPACITY=1
ECS_AUTOSCALING_MAX_CAPACITY=2
ECS_HEALTH_CHECK_GRACE_PERIOD_SECONDS=900
ECS_CAPACITY_PROVIDER_TARGET_CAPACITY=100
ECS_CAPACITY_PROVIDER_MIN_SCALING_STEP=1
ECS_CAPACITY_PROVIDER_MAX_SCALING_STEP=1
ECS_CAPACITY_PROVIDER_WEIGHT=1
ECS_CAPACITY_PROVIDER_BASE=1

ALB_HEALTHCHECK_PATH=/api/v1/health
ALB_HEALTHCHECK_INTERVAL_SECONDS=60
ALB_HEALTHCHECK_TIMEOUT_SECONDS=30
ALB_HEALTHCHECK_HEALTHY_THRESHOLD=2
ALB_HEALTHCHECK_UNHEALTHY_THRESHOLD=2
ECS_STABILITY_MAX_ATTEMPTS=60
ECS_STABILITY_SLEEP_SECONDS=30
POST_DEPLOY_HEALTHCHECK_ATTEMPTS=30
POST_DEPLOY_HEALTHCHECK_SLEEP_SECONDS=30

GPU_ECS_AMI_ID=ami-xxxxxxxxxxxxxxxxx
GPU_EC2_INSTANCE_TYPE=g4dn.xlarge
# Opcional (default 100). O default da AMI (~30 GB) estoura no pull da imagem CUDA+torch.
GPU_ROOT_VOLUME_SIZE_GB=100
GPU_ASG_MIN_SIZE=1
GPU_ASG_MAX_SIZE=1
GPU_ASG_DESIRED_CAPACITY=1
GPU_ASG_HEALTH_CHECK_GRACE_PERIOD_SECONDS=300

LAMBDA_RECODERS_LIST='LOC1|Localidade 1_LOC2|Localidade 2'
LAMBDA_SERVICE_TYPE=whisper
# LAMBDA_TRANSCRIBE_PROVIDER: define o motor de transcrição usado pela Lambda.
#   internal = FastAPI interna com Whisper rodando no ECS (padrão para este sistema)
#   externo  = Amazon Transcribe (serviço AWS pago — arquitetura alternativa)
LAMBDA_TRANSCRIBE_PROVIDER=internal

ECS_CLUSTER_NAME={project_name}-cluster-dev
ECS_SERVICE_NAME=fastapi-service
ALB_NAME={project_name}-alb-dev
TRANSCRIPTIONS_TABLE_NAME=TranscriptionsTable
TRANSCRIBE_QUEUE_NAME={project_name}-queue-dev.fifo
TRANSCRIBE_DLQ_NAME=dlq-{project_name}-queue-dev.fifo
TRANSCRIBE_AUDIO_TO_SEARCH_LAMBDA_NAME=transcribe_audio_to_elastic_search
FASTAPI_LOG_GROUP_NAME=/ecs/{project_name}-log-group-dev

# --- destroy_all_trancribe.sh (todas opcionais; o valor mostrado é o default) ---
# Etapas do destroy. DESTROY_BACKEND=false protege o bucket de state e a tabela de lock.
DESTROY_TERRAFORM=true
DESTROY_OPENSEARCH_DOMAIN=true
DESTROY_OPENSEARCH_SG=true
DESTROY_ECR=true
DESTROY_BACKEND=false
# false = o terraform destroy pede confirmação interativa.
TF_DESTROY_AUTO_APPROVE=false

# Opcional na esteira; o módulo Terraform atual pode continuar exigindo este valor no plan/apply.
TF_VAR_openai_api_key=
