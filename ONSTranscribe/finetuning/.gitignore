# Dados de treinamento — nunca commitar
# Contêm áudios, transcrições reais e metadados sensíveis
data/
# Excecao: 'data' tambem e o nome de um modulo do pacote diarizers, que e codigo
# vendorizado e precisa ser distribuido. Sem isto o pacote fica sem o modulo.
!**/src/diarizers/data/
!**/src/diarizers/data/**

# Workspace local — cópias dos notebooks de exemplo para execução real
# Gerado por: bash finetuning/scripts/setup_workspace.sh
workspace/

# Outputs de treinamento que podem conter caminhos internos ou predições
finetune_whisper/whisper_finetuned*/
finetune_whisper/runs/
finetune_whisper/embeddings_save/

# Checkpoints intermediários do Whisper trainer
# (training_args.bin contém paths internos; trainer_state.json contém histórico de loss)
**/checkpoint-*/

# Logs do TensorBoard (podem conter sample predictions com transcrições reais)
**/runs/
**/*.tfevents.*

# Modelos treinados (binários pesados, treinados em dados proprietários)
**/*.joblib
**/*.npy
**/*.safetensors
**/*.bin
# Exceção: arquivos de configuração de modelo (não contêm dados de treino)
!**/config.json
!**/generation_config.json
!**/tokenizer*.json
!**/vocab.json
!**/merges.txt
!**/special_tokens_map.json
!**/preprocessor_config.json

# Datasets intermediários salvos em disco
**/asr_dataset*/
